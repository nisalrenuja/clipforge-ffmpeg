# Pinned sources for the Clipforge LGPL FFmpeg build. Bump deliberately (security fixes).
FFMPEG_VERSION=8.1.3
FFMPEG_SHA256=7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3
OPENH264_VERSION=2.7.0
OPENH264_SHA256=5178775c8b440073e70920e97d195efff721c0e56d0a78cc82c919e95d54924d
KVAZAAR_VERSION=2.3.2
KVAZAAR_SHA256=ddd0038696631ca5368d8e40efee36d2bbb805854b9b1dda8b12ea9b397ea951
SVTAV1_VERSION=3.1.2
SVTAV1_SHA256=d0d73bfea42fdcc1222272bf2b0e2319e9df5574721298090c3d28315586ecb1
MACOS_MIN=13.0

# Windows x64: BtbN LGPL build, mirrored (BtbN prunes dated autobuilds).
WIN_BTBN_TAG=autobuild-2026-11-21-12-37
WIN_BTBN_ASSET=ffmpeg-n8.1.3-39-g660b5aa7db-win64-lgpl-8.1.zip
WIN_BTBN_SHA256=47d2e37e5ab9dc775cf5e5e595a817a11534c2fd6533a16db476f45dd8a7ce83

# whisper.cpp (speech-to-text for Clipforge add-analysis, MIT). Built by .github/workflows/build-whisper.yml.
WHISPER_VERSION=1.9.5
WHISPER_SHA256=ff1a9053feb509ff9d7729703355541ae9690073a6b1c40eb692c962e0dc1720
# Build-time only (Windows Vulkan backend); not shipped. The Vulkan loader comes with the GPU driver.
VULKAN_SDK_VERSION=1.4.363.1

# Sinhala speech model (Clipforge add-sinhala-speech): SinhaSpeech's full fine-tune of Whisper
# small (Apache-2.0; 15.52 % WER on a speaker-disjoint test set), converted to whisper.cpp ggml
# and quantised by .github/workflows/convert-sinhala-model.yml. Training data
# (SinhaSpeech/sinhala-asr-data-v6) publishes no licence: review before a paid release.
SINHALA_MODEL_REPO=SinhaSpeech/whisper-small-sinhala-run12-best
SINHALA_MODEL_REV=96eac6280bc937432db4b58c5ec2641826732552
SINHALA_MODEL_SAFETENSORS_SHA256=38f25d86f541c4652e2d2cb84e1567c8013ed271baf982a814d086bee4d2c3bb
# openai/whisper (MIT) at a fixed commit: the converter reads its mel filters.
OPENAI_WHISPER_COMMIT=86098128c0b4f24f0e2aa2994de830614b474227
